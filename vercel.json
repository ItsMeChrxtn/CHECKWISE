{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix client ci && npm --prefix client run build",
  "outputDirectory": "client/dist",
  "installCommand": "echo \"install happens in buildCommand, inside client/\"",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://checkwise-b5ui.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://checkwise-b5ui.onrender.com/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
