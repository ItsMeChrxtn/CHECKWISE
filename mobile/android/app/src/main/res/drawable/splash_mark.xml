<?xml version="1.0" encoding="utf-8"?>
<!--
  The CheckWise mark: an answer bubble with a check struck through it. Matches
  client/src/components/Logo.jsx stroke for stroke.

  Drawn on a 108dp canvas so Android 12's splash API has the padding it wants —
  it masks the animated icon to a circle and clips anything near the edge.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The bubble, left open at the top right so the check reads as passing
         through it rather than sitting on top. -->
    <path
        android:pathData="M79,37.8 A30.4,30.4 0 1 0 84.4,54"
        android:strokeColor="#3A5BB0"
        android:strokeAlpha="0.35"
        android:strokeWidth="8.8"
        android:strokeLineCap="round" />

    <!-- The mark it earned. -->
    <path
        android:pathData="M37.8,55.4 L50.6,68.2 L82.4,35.1"
        android:strokeColor="#3A5BB0"
        android:strokeWidth="10.1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
