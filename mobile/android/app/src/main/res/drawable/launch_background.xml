<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android-12 launch screen: the navy field with the check centred on it.
  Android 12 and up ignore this and use the splash API in values-v31.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_bg" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_mark" />
    </item>
</layer-list>
