<?xml version="1.0" encoding="utf-8"?>
<!--
  API 21+ launch screen. This qualifier wins over drawable/ on every device
  Flutter supports, and the template's `?android:colorBackground` resolved to
  white — the flash before the navy appeared.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_bg" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_mark" />
    </item>
</layer-list>
