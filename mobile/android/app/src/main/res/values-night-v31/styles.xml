<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 replaced the windowBackground trick with a real splash API, and
  ignores the old drawable. Without this the system would show the launcher
  icon on a plain background and the navy would only appear once Flutter drew
  its first frame — the white flash this is here to remove.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
