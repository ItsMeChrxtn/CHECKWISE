# Copy this file to server/.env and fill in the values. Never commit .env.

PORT=5000
NODE_ENV=development

# Local MongoDB, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/checkwise

# Sign JWTs with a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origin allowed by CORS (the Vite dev server).
CLIENT_URL=http://localhost:5173

# Maximum upload size in megabytes for exam PDFs and scanned answer sheets.
MAX_UPLOAD_MB=15
